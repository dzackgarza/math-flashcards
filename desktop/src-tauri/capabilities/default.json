{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "store:default",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "core:window:allow-destroy"
  ]
}
