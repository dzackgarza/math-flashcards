{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Math Flashcards",
  "version": "0.1.0",
  "identifier": "dev.math.flashcards",
  "build": {
    "beforeDevCommand": "just -f ../justfile desktop-web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "just -f ../justfile desktop-frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Math Flashcards",
        "width": 1440,
        "height": 1000,
        "minWidth": 760,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend.py": "backend.py",
      "../paired-cards.lua": "paired-cards.lua"
    }
  }
}
